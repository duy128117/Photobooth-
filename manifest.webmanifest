{
  "name": "Photobooth",
  "short_name": "Photobooth",
  "description": "Photobooth web app with camera capture, stickers, filters, offline editor, and downloadable photo strips.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#101625",
